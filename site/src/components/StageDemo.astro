---
/**
 * An interactive mock of the iPad/Mac sliding stage — the one feature a
 * screenshot genuinely cannot convey, because the *movement between* the three
 * arrangements is the feature.
 *
 * The geometry here is copied from the real thing (`GameDetailView.stageLayout`):
 * the game page is full width at stage 1 and 58% after; the tracker panel sits
 * at 42% until stage 3 widens it to 46%; the video panel is 54% and slides in
 * from the right. Matching the actual numbers means the demo moves the way the
 * app moves rather than the way a marketing site imagines it does.
 *
 * ⚠️ HONESTY RULE: this may only show behaviour the app actually has. It is a
 * reimplementation, so it can drift — if the stage layout changes, change this
 * too or remove it. A demo that lies is worse than no demo.
 */
---
<div class="stage" data-stage-demo data-stage="1">
  <div class="stage__controls" role="group" aria-label="Choose an arrangement">
    <button type="button" data-stage-btn="1" aria-pressed="true">Game page</button>
    <button type="button" data-stage-btn="2" aria-pressed="false">+ Tracker</button>
    <button type="button" data-stage-btn="3" aria-pressed="false">+ Guide</button>
  </div>

  <div class="stage__frame">
    <!-- Game page -->
    <div class="stage__panel stage__game">
      <div class="stage__head"><span class="stage__title">Hollow Knight</span></div>
      <div class="stage__row"><span class="dot"></span>Sessions<b>41h 12m</b></div>
      <div class="stage__timer">00:24:18<em>Pause</em><em>Stop</em></div>
      <div class="stage__row">Runs<b>0</b></div>
      <div class="stage__row stage__row--tap">Tracker &middot; Playthrough<b>62%</b></div>
      <div class="stage__row">Guides &amp; Videos<b>3</b></div>
    </div>

    <!-- Tracker -->
    <div class="stage__panel stage__tracker">
      <div class="stage__head">
        <span class="stage__title"><span class="live"></span>Playthrough <i>tracker</i></span>
        <span class="stage__timerchip" data-stage-timer>00:24:18</span>
      </div>
      <div class="stage__bar"><span></span></div>
      <div class="stage__row">Bosses<b>9/14</b></div>
      <div class="stage__row">Charms<b>28/45</b></div>
      <div class="stage__row">Grubs<b>31/46</b></div>
      <div class="stage__row">Nail Upgrades<b>3/4</b></div>
      <div class="stage__row">Endings<b>1/3</b></div>
    </div>

    <!-- Guide video -->
    <div class="stage__panel stage__video">
      <div class="stage__head"><span class="stage__title">Guides &amp; Videos</span></div>
      <div class="stage__player"><span>&#9654;</span></div>
      <div class="stage__row">Part 4 &middot; Soul Sanctum<b>12:04</b></div>
      <div class="stage__row">Part 5 &middot; City of Tears<b>—</b></div>
    </div>
  </div>

  <p class="stage__caption" data-stage-caption>
    The game page on its own. Tap <b>+ Tracker</b> to slide the checklist in beside it.
  </p>
</div>

<script>
  const captions: Record<string, string> = {
    '1': 'The game page on its own. Tap <b>+ Tracker</b> to slide the checklist in beside it.',
    '2': 'Checklist beside the game page — tick things off without losing the session timer.',
    '3': 'A guide playing next to the checklist. The timer moves into the tracker header, because the page it lived on has slid away.',
  };

  document.querySelectorAll('[data-stage-demo]').forEach((root) => {
    const caption = root.querySelector('[data-stage-caption]') as HTMLElement;
    const buttons = [...root.querySelectorAll('[data-stage-btn]')] as HTMLButtonElement[];

    const set = (stage: string) => {
      root.setAttribute('data-stage', stage);
      caption.innerHTML = captions[stage];
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.stageBtn === stage))
      );
    };

    buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.stageBtn!)));
    // Tapping the tracker row is how you'd do it in the app, so it works here too.
    root.querySelector('.stage__row--tap')?.addEventListener('click', () => set('2'));
  });
</script>

<style>
  .stage { --ease: cubic-bezier(.34, 1.2, .64, 1); }

  .stage__controls { display: flex; gap: .5rem; margin-bottom: .9rem; flex-wrap: wrap; }
  .stage__controls button {
    font: inherit;
    font-size: .85rem;
    padding: .4rem .8rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  .stage__controls button[aria-pressed='true'] {
    background: var(--accent, #945CFA);
    border-color: var(--accent, #945CFA);
    color: #FFFFFF;
    font-weight: 600;
  }

  .stage__frame {
    position: relative;
    overflow: hidden;
    height: 340px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, .02);
  }

  .stage__panel {
    position: absolute;
    inset: 0 auto 0 0;
    padding: .85rem;
    transition: transform 520ms var(--ease), width 520ms var(--ease);
    overflow: hidden;
    background: #120E20;
  }
  .stage__tracker, .stage__video {
    border-left: 1px solid rgba(148, 92, 250, .3);   /* accent purple, not torch */
    background: #16112a;
  }

  /* Geometry mirrors GameDetailView.stageLayout. */
  .stage[data-stage='1'] .stage__game    { width: 100%; transform: translateX(0); }
  .stage[data-stage='2'] .stage__game    { width: 58%;  transform: translateX(0); }
  .stage[data-stage='3'] .stage__game    { width: 58%;  transform: translateX(-100%); }

  .stage[data-stage='1'] .stage__tracker { width: 42%; transform: translateX(238%); }
  .stage[data-stage='2'] .stage__tracker { width: 42%; transform: translateX(138%); }
  .stage[data-stage='3'] .stage__tracker { width: 46%; transform: translateX(0); }

  .stage[data-stage='1'] .stage__video,
  .stage[data-stage='2'] .stage__video   { width: 54%; transform: translateX(189%); }
  .stage[data-stage='3'] .stage__video   { width: 54%; transform: translateX(85.2%); }

  /* The timer only appears in the tracker header at stage 3 — exactly as in the
     app, where stages 1 and 2 still show the full Sessions controls. */
  .stage__timerchip { opacity: 0; transition: opacity 260ms ease; font-variant-numeric: tabular-nums; color: var(--accent, #945CFA); font-size: .78rem; }
  .stage[data-stage='3'] .stage__timerchip { opacity: 1; }
  .stage[data-stage='3'] .stage__timer { opacity: .35; }

  .stage__head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding-bottom: .55rem; border-bottom: 1px solid var(--line); margin-bottom: .55rem; }
  .stage__title { font-size: .85rem; font-weight: 600; display: flex; align-items: center; gap: .35rem; white-space: nowrap; }
  .stage__title i { font-style: normal; font-weight: 400; font-size: .74rem; color: var(--muted); }
  .live { width: 7px; height: 7px; border-radius: 50%; background: #56D364; flex: none; }

  .stage__row { display: flex; align-items: center; gap: .4rem; font-size: .78rem; color: #D6CFEA; padding: .42rem 0; border-bottom: 1px solid rgba(255,255,255,.045); white-space: nowrap; }
  .stage__row b { margin-left: auto; color: var(--muted); font-weight: 500; }
  .stage__row--tap { cursor: pointer; color: var(--accent, #945CFA); }
  .stage__row .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent, #945CFA); }

  .stage__timer { font-size: 1.5rem; font-variant-numeric: tabular-nums; color: var(--accent, #945CFA); padding: .5rem 0; display: flex; align-items: baseline; gap: .5rem; transition: opacity 260ms ease; }
  .stage__timer em { font-style: normal; font-size: .7rem; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: .15rem .5rem; }

  .stage__bar { height: 5px; border-radius: 999px; background: rgba(255,255,255,.08); margin-bottom: .6rem; }
  .stage__bar span { display: block; height: 100%; width: 62%; border-radius: inherit; background: var(--accent, #945CFA); }

  .stage__player { aspect-ratio: 16/9; border-radius: 8px; background: linear-gradient(135deg, #1d2b4a, #10182b); display: grid; place-items: center; margin-bottom: .55rem; }
  .stage__player span { color: rgba(255,255,255,.6); font-size: 1.6rem; }

  .stage__caption { font-size: .9rem; color: var(--muted); margin: .8rem 0 0; min-height: 2.6em; }

  @media (max-width: 640px) {
    .stage__frame { height: 300px; }
    .stage__row, .stage__title { font-size: .72rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__panel { transition: none; }
  }
</style>
