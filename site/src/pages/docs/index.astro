---
import Base from '../../layouts/Base.astro';

/* Direction A: a short path for someone who just installed the app, then
   reference sections for everyone coming back with a specific question. The
   path stays three steps forever; the reference underneath can grow without
   pushing the beginning of the page further down. */
const steps = [
  {
    t: 'Add your first game',
    d: 'Search for it and the cover, platform and details come with it. Got a library elsewhere? Settings → Your data → Import from CSV brings the lot in at once.',
    time: '1 min',
  },
  {
    t: 'Start a session',
    d: "Time what you play. It keeps counting on the Lock Screen, in a widget, and on your watch — and nudges you if you forget to stop it.",
    time: '10 sec',
  },
  {
    t: 'Give it a tracker',
    d: 'This is the part people stay for. Paste a checklist you already trust from a wiki or guide, or let LevelSelect draft one for the game.',
    time: '2 min',
    link: { href: '#paste', label: 'How pasting works' },
  },
];

/**
 * The reference sections, in page order.
 *
 * The page had eleven h2s and no way to see them: a wall of scroll that told
 * you nothing about its own length or shape, which is exactly the page people
 * leave. This list drives both the desktop rail and the phone jump menu, so
 * there is one place to change and the nav cannot describe a page that no
 * longer exists.
 */
/**
 * The reference sections, in page order.
 *
 * Labelled as QUESTIONS, not features — the change that matters here.
 *
 * Every label used to name the answer: "RetroAchievements", "Sessions and runs
 * are different things", "Beaten is a moment; 100% is your list". Good
 * sentences, and useless as navigation: you can only recognise them as
 * relevant once you already understand the distinction, which is the thing you
 * came to learn. The nav asked you to do the categorising before it would help
 * — and that first decision is where people leave. Tim, who has ADHD, on this
 * page: "the nav doesn't really help if I don't know what I'm looking for…
 * I am likely to bounce off of rather than actually try to find what I'm
 * wanting."
 *
 * `q` drives the rail, the phone menu AND the heading, so what you clicked is
 * what you land on. `a` is the one-sentence answer under the heading: the page
 * used to make you read ~240 words to find out whether a section was the one
 * you wanted, and now you can scan all fourteen answers in less than that.
 */
const sections = [
  { id: 'profile',           q: 'How do I set up my profile?',
    a: 'Settings → Your profile. It draws nothing on Home until you put something in it.' },
  { id: 'layouts',           q: 'Can I change how a game page looks?',
    a: 'Settings → Game page layout. Four arrangements of the same page.' },
  { id: 'colors',            q: 'Can I change the colors?',
    a: 'Settings → Accent color, or any status color. Swatches, sliders, or a hex field.' },
  { id: 'paste',             q: 'I have a checklist from a wiki',
    a: 'Tracker → Paste a List turns it into real tracker categories, in two formats.' },
  { id: 'regenerating',      q: 'Will regenerating lose my progress?',
    a: 'No. The button tells you what it is about to do, and a long-press changes it for one run.' },
  { id: 'notes',             q: 'Where do notes and “where I left off” go?',
    a: 'Any tracker item can carry a note — press and hold the row, then Edit item.' },
  { id: 'hints',             q: 'How do I avoid spoilers?',
    a: 'Settings → Appearance turns off the hints that generated and imported lists carry.' },
  { id: 'retroachievements', q: 'I want my retro achievements in here',
    a: 'For retro games LevelSelect installs the real authored list, not an approximation.' },
  { id: 'sessions',          q: 'Why is my playtime wrong?',
    a: 'A session is time played; a run is one attempt at something. They count differently.' },
  { id: 'widgets',           q: 'I want it on my Home Screen',
    a: 'Home Screen, Lock Screen, and extra-large boards on iPad. Long-press to aim one.' },
  { id: 'shortcuts',         q: 'Can I use Siri for this?',
    a: 'Every game is a real entity in Shortcuts, Siri and Spotlight — not just the app.' },
  { id: 'beaten',            q: 'I finished a game — what do I mark?',
    a: 'Beating it and finishing your tracker are different things, and both are recorded.' },
  { id: 'stats',             q: 'What do the charts show?',
    a: 'Every breakdown card turns over: tap the chart icon for a donut instead of bars.' },
  { id: 'data',              q: 'How do I get my data out?',
    a: 'Settings → Your data → Export library writes a readable JSON file of everything.' },
];

/**
 * The front door: what just happened, rather than what it is called.
 *
 * A list of fourteen still asks you to choose from fourteen. These are the
 * moments people are actually in when they come looking, and each one opens
 * onto the two or three answers that apply. The full list stays below for
 * anyone who would rather scan it.
 */
const moments = [
  { t: 'I am just setting up',            ids: ['profile', 'layouts', 'colors'] },
  { t: 'I want a checklist for this game', ids: ['paste', 'regenerating', 'notes', 'hints', 'retroachievements'] },
  { t: 'My playtime looks wrong',         ids: ['sessions'] },
  { t: 'I want it outside the app',       ids: ['widgets', 'shortcuts'] },
  { t: 'I just finished a game',          ids: ['beaten', 'stats'] },
  { t: 'I want my data out',              ids: ['data'] },
];

/**
 * The two lists are one list.
 *
 * The cards are the way in now, so a question no card points at is a question
 * nobody finds — it exists only for whoever scrolls the whole reference, which
 * is the wall of text this page was rebuilt to stop being. And Tim's rule for
 * the reference below is that it runs in the order the cards do.
 *
 * Both hold only while somebody remembers, so neither is left to memory: the
 * order below IS the card order, and a section belonging to no card fails the
 * build rather than quietly going missing.
 */
const ordered = moments.flatMap((m) => m.ids);
const orphans = sections.filter((x) => !ordered.includes(x.id)).map((x) => x.q);
if (orphans.length) throw new Error(`Help: no card points at ${orphans.join(', ')}`);
if (sections.map((x) => x.id).join() !== ordered.join())
  throw new Error('Help: the reference is not in card order');
---
<Base
  title="Help — LevelSelect"
  description="How to use LevelSelect: where to begin, pasting a checklist into a tracker, Siri and Shortcuts, widgets, and getting your data out."
  current="docs"
>
<main class="wrap doc-page">
  <article class="doc">
    <h1>Help</h1>
    <p class="stamp">Last updated 1 September 2026</p>

    <p class="lede">New here? The three steps below are the whole shape of the app. Everything after them is reference — read it when you need it, not now.</p>

    <ol class="guide-steps">
      {steps.map((s) => (
        <li class="guide-step">
          <span class="guide-step__n" aria-hidden="true"></span>
          <div class="guide-step__body">
            <b class="guide-step__t">{s.t}</b>
            <span class="guide-step__d">{s.d}</span>
            {s.link && <a class="guide-step__link" href={s.link.href}>{s.link.label} &rarr;</a>}
          </div>
          <span class="guide-step__time">{s.time}</span>
        </li>
      ))}
    </ol>

    <p class="divider"><span>Or start from what just happened</span></p>

    <ul class="moments">
      {moments.map((m) => (
        <li class="moment">
          <b class="moment__t">{m.t}</b>
          <span class="moment__links">
            {m.ids.map((id) => {
              const s = sections.find((x) => x.id === id)!;
              return <a href={`#${id}`}>{s.q}</a>;
            })}
          </span>
        </li>
      ))}
    </ul>

    <p class="divider"><span>Everything, in order</span></p>

    <details class="qa" id="profile" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'profile')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'profile')!.a}</span>
      </summary>
      <div class="qa__body">
    <p><strong>Settings &rarr; Your profile.</strong> A picture, a name, and your handles. It draws nothing on Home until you put something in it, so an empty profile costs you no space.</p>

    <h3>The picture</h3>
    <p>Tap the picture itself to choose where it comes from: a photo, the artwork of any game in your library, or a sticker &mdash; Memoji, Genmoji, or one you made from your own photo. The app decides what to do next by looking at the image. Something with a transparent background is already the subject, so it goes straight in and is drawn whole. A photo or a wide piece of key art asks you to choose which square survives, because something has to and you are better at it than a center crop.</p>

    <h3>Handles</h3>
    <p>Add a handle once, then tick everywhere you use it. That is the whole design: someone who uses the same name on five services types it once, not five times. Sign up somewhere new later and you open that handle and add the service rather than starting again.</p>
    <p>A service belongs to one handle. Picking one that already sits on another handle moves it, and the row tells you so before you tap. You can add services the app has never heard of &mdash; Apple Arcade, a storefront, a forum.</p>
    <p><strong>Handles are decoration.</strong> Nothing signs in, nothing is fetched, nothing is shared. The one handle that does real work is your RetroAchievements username, and it is deliberately somewhere else: in the Keychain, on your device, never synced.</p>

    <h3>Your name, and its color</h3>
    <p>Use a handle as your name and the two stay linked &mdash; rename the handle and the name follows. The name can take a color of its own, and choosing <em>Accent</em> keeps it matched to your accent as you change it, rather than freezing a copy of whatever it is today.</p>
      </div>
    </details>

    <details class="qa" id="layouts" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'layouts')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'layouts')!.a}</span>
      </summary>
      <div class="qa__body">
    <p><strong>Settings &rarr; Game page layout.</strong> Four arrangements of the same page:</p>
    <ul>
      <li><strong>Showcase</strong> &mdash; the art fills the top with the logo underneath. The most visual.</li>
      <li><strong>Classic</strong> &mdash; close to the original: cover on the left, details beside it.</li>
      <li><strong>Cover</strong> &mdash; box art leads, at the size box art deserves.</li>
      <li><strong>Compact</strong> &mdash; nearly all list, with the art reduced to a tint.</li>
    </ul>
    <p>The choice applies to every game and syncs with your library. There is no right answer &mdash; pick the one that matches how you read a page.</p>

    <h3>Logos</h3>
    <p>Game pages fetch a wordmark on their own, from IGDB first and SteamGridDB after, and fall back to the game's name as text when neither has one. <strong>Settings &rarr; Use game logos</strong> turns it off if you would rather always read the name. You can still choose a specific logo per game from that game's artwork picker, and an explicit choice always wins.</p>
      </div>
    </details>

    <details class="qa" id="colors" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'colors')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'colors')!.a}</span>
      </summary>
      <div class="qa__body">
    <p><strong>Settings &rarr; Accent color</strong>, or any status color under Status colors. Each opens the same editor: a grid to pick from, three sliders, and a hex field if you already know the color you want.</p>
    <p>The <strong>+</strong> keeps a color you have made, so you do not have to find it again; long-press one of your kept colors to remove it. <strong>Cancel</strong> puts back what was there when you opened the editor, so you can drag a slider and watch the real app behind the sheet without committing. <strong>Use the default</strong> resets that one color, leaving every other color you have chosen alone.</p>
    <p>Kept colors live on the device. Your accent and status colors sync.</p>
      </div>
    </details>

    <details class="qa" id="paste" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'paste')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'paste')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>Most games worth tracking already have a good checklist somewhere — a wiki table, a forum post, a guide. <strong>Tracker &rarr; Paste a List</strong> turns one into real tracker categories. Nothing is sent anywhere, no AI is involved, and nothing is invented: every item comes from your text. It does interpret as it reads — stripping list syntax, working out which part of a line is the name and which is the location — and the rest of this section explains exactly how, so you can predict what it will do.</p>

    <h3>Two formats work</h3>
    <p><strong>A table</strong>, with a header row. Column names are matched loosely, so most wiki tables work as-is:</p>
    <pre><code>| Item      | Effect              | Location   | Notes            |
| --------- | ------------------- | ---------- | ---------------- |
| Lace Glove| Raises Attack by one| Ossex      | Reward from Ack  |</code></pre>
    <p>Recognized headers include <em>Item, Name, Trinket, Title, Collectible</em> for the name; <em>Location, Area, Region, Zone</em> for where it is; <em>Effect, Description, Details</em>; and <em>Notes, How, Source, Hint</em>. Anything unrecognized is skipped and reported rather than guessed at.</p>

    <p><strong>Or headed sections</strong> of numbered or bulleted lines:</p>
    <pre><code>## Heart Coins
### Koala Village
- [ ] Nia's Bedroom
- [ ] Cave behind the house

## Honey Pots
1. Alberto's Farm - Yak Cave</code></pre>
    <p><code>##</code> becomes a category. <code>###</code> becomes the <em>location</em> for the items beneath it. Checkboxes, numbers and bullets are all stripped.</p>

    <h3>The one rule worth knowing</h3>
    <p>In a line like <code>Koala Village - Nia's Bedroom</code>, is the first part a place or the item's name? LevelSelect decides by whether it <strong>repeats</strong>: a leading phrase that appears on several lines in the same section is treated as a location, and one that's different every time is treated as the item's name.</p>
    <p>That gets it right for most lists — "Koala Village" nine times is clearly a place; "Wallet 1, Wallet 2, Bombs 1" are clearly items. Where a section is genuinely mixed, the preview screen shows which reading it chose and lets you flip it with one tap.</p>
    <p>If you'd rather not rely on the guess, use <code>###</code> headings for locations. An explicit heading always wins.</p>

    <h3>What is deliberately not split</h3>
    <p>Only <code> - </code> (with spaces around it) separates a line. Commas never do — otherwise "Crab, Eel, Perch, Trout" would shatter into four items. That's why a line written with commas comes through as one long name; renaming it takes a moment, and a parser that split on commas would quietly wreck other lists.</p>

    <h3>Imported lists are protected</h3>
    <p>Anything you paste in is <strong>locked</strong>: regenerating that game's tracker later won't remove or replace it. You brought that list deliberately, so nothing automatic gets to overrule it.</p>
      </div>
    </details>

    <details class="qa" id="regenerating" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'regenerating')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'regenerating')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>The generate button tells you what it's going to do, and you can change it for a single run by long-pressing.</p>
    <ul>
      <li><strong>Add New Only</strong> (the default) — keeps everything you have and adds what's missing. It never removes or overwrites anything already in your tracker.</li>
      <li><strong>Review Changes</strong> — generates, then shows you what would be added, removed and renamed, grouped by category. Nothing is written until you choose.</li>
      <li><strong>Replace Everything</strong> — swaps the generated content out. It asks first.</li>
    </ul>
    <p>Generation doesn't name things identically each time, so an item can come back with a different internal id. LevelSelect follows those renames by matching names and carries your progress across, telling you how many it moved — matching is careful but not psychic, so the review screen is there to check before a Replace. If something you'd worked on genuinely isn't in the new tracker, you're offered the chance to keep it as a personal goal rather than losing it.</p>
    <p>Your own notes stay yours: no merge mode rewrites them, and a Replace carries each note across wherever its item can still be matched.</p>
      </div>
    </details>

    <details class="qa" id="notes" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'notes')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'notes')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>Any tracker item can carry <strong>your own note</strong> — press and hold the row and choose <em>Edit item</em>. It's for the thing the checklist can't know: which NPC you were mid-quest with, where you'd stashed the key, what you meant to try next. The note shows on the item itself, in your accent color, marked as yours rather than as more of whatever generated the list. Regenerating the tracker never touches it.</p>
    <p>The same sheet is where you rename an item to whatever you actually call it, and record where it is.</p>
    <p><strong>Where you left off</strong> sits at the top of the Tracker section: the last thing you ticked, when you ticked it, and your note about it if you wrote one. It's there for the game you haven't opened in three weeks — a percentage tells you how far you got, but not what you were <em>doing</em>. It records the moment you ticked something, so editing an old item later won't push it to the front. The same line appears on the Continue Playing card and its widget, so the answer reaches you before you open the app.</p>

    <p>Finishes can be corrected, too: tap any entry under <strong>Beaten</strong> to fix a date you now remember better, change what it was, or add who you played it with. <strong>Played with</strong> is written down and nothing more — the app has no accounts and shares nothing — so a couch co-op finish remembers who was there.</p>
      </div>
    </details>

    <details class="qa" id="hints" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'hints')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'hints')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>Generated and imported checklists usually carry a hint or a location for each item — useful when you're hunting, spoilers when you're not. <strong>Settings &rarr; Appearance &rarr; Show item hints</strong> turns them off: rows become just their names, and location headings disappear too.</p>
    <p>When you actually want one hint, <strong>press and hold that row</strong> — a card shows that item's hint, location, and badge, and nothing else. One item at a time, so checking a single objective can't spoil the list below it. Your own notes on items always stay visible; they're yours, not hints.</p>
      </div>
    </details>

    <details class="qa" id="retroachievements" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'retroachievements')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'retroachievements')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>For retro games, LevelSelect can install the <strong>real, authored achievement list</strong> from <a href="https://retroachievements.org">RetroAchievements</a> instead of generating an approximation — point values, missable flags, and each achievement's own badge art, in color once you've earned it and RA's grayed version while you haven't.</p>
    <p>Connect your account in Settings and imported sets arrive <strong>already ticked</strong> with what you've earned, and a sync can only ever add — the app knows RA has no idea you played the cartridge on real hardware last week. Stats gains a wall of your mastered and completed sets, gold-bordered only for hardcore mastery, because that distinction is RA's and the app keeps it. Your API key goes from your device to RetroAchievements directly — it never touches our servers, and it stays in the Keychain on each device.</p>
    <p>Doors out are everywhere the set is: the set's page on RA from the tracker, and your own profile from RetroAchievements settings.</p>
      </div>
    </details>

    <details class="qa" id="sessions" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'sessions')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'sessions')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>A <strong>session</strong> is time played — start it and it counts, including on the Lock Screen and your watch. A <strong>run</strong> is one attempt at something, for roguelikes: a loadout, an outcome, and a win rate over time.</p>
    <p>They're deliberately separate. A run doesn't start a timer, and a session doesn't record a run, so your playtime never gets inflated by counting attempts. Run logging is off until you turn it on for a game — the Tracker section's <strong>Build</strong> menu, <em>Log Runs for This Game</em> — because plenty of games deserve a tracker without one. Once it's on, the Runs section carries its own controls, including switching it back off.</p>
      </div>
    </details>

    <details class="qa" id="widgets" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'widgets')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'widgets')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>Widgets live on the Home Screen and the Lock Screen, and at extra-large sizes on iPad:</p>
    <ul>
      <li><strong>Home Screen:</strong> Continue Playing (with a tappable next objective), <strong>"Choose a Game for Me"</strong> — a die that picks off your shelf and stands by its pick until you roll again — <strong>"Open To…"</strong> launchers that jump straight into a collection, status shelf or system, carrying that section's own cover art at medium and large sizes &mdash; point one at <em>Now Playing</em> and you have a shelf of what you are playing, a sixteen-week play heatmap, week and run trackers, and completion rings.</li>
      <li><strong>iPad only:</strong> three extra-large boards — a Command Board (your game, its objectives, the shelf, the week, all at once), a twelve-cover Shelf, and Where You Stand, a progress bar for everything you're playing.</li>
      <li><strong>Lock Screen:</strong> a die that opens the app on a fresh random pick every tap, a week gauge measured against your own pace, a play streak, your current game's next objective with a real tick button — and the completion ring that was already there. Four circles fit the bar exactly.</li>
      <li><strong>Configuring:</strong> long-press any widget &rarr; Edit Widget. The die takes statuses, one system, and an include-finished toggle; different placements roll independently. Launchers take any collection, status, or system you have.</li>
      <li><strong>If art looks missing at first:</strong> open the app once — widgets draw from a snapshot the app refreshes, and cover art for newly-placed widgets is fetched on the next open.</li>
    </ul>
      </div>
    </details>

    <details class="qa" id="shortcuts" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'shortcuts')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'shortcuts')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>Every game in your library is a real entity in the Shortcuts app, Siri, and Spotlight — not just the app itself, each <em>game</em>. That means:</p>
    <ul>
      <li><strong>"Play Hollow Knight in LevelSelect"</strong> starts a timed session for that game — from Siri, without opening anything. "Open <em>game</em> in LevelSelect" jumps to its page.</li>
      <li><strong>"Continue playing in LevelSelect"</strong> resumes whatever you were last playing. "Open LevelSelect stats" (or library, or wishlist) goes straight to a tab.</li>
      <li><strong>Build your own automations.</strong> Because sessions are Shortcuts actions, you can wire them to anything the Shortcuts app can see: an NFC tag stuck to the console that starts a session when you tap your phone on it, a Focus that opens your library, a bedtime automation that reminds you a timer's still running.</li>
    </ul>
    <p>Nothing to set up — the shortcuts register themselves when the app is installed. Open the Shortcuts app and search LevelSelect to see the full set.</p>
      </div>
    </details>

    <details class="qa" id="beaten" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'beaten')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'beaten')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>Beating a game and finishing every item on your tracker are different achievements, and LevelSelect records them separately. On any game's page, in the <strong>Beaten</strong> section, mark <em>Beat the game</em>, <em>100%</em>, <em>New Game+</em>, or your own words. "100%" means everything on <em>your</em> list, the one you chose to keep; it doesn't claim a platinum.</p>
    <p>Dates are stored only as precisely as you know them: an exact day for last night's credits, a month for "sometime that spring," a bare year for the game you beat in 2011 — and shown exactly that vaguely, because the app doesn't pretend to know more than you told it. Logging your history needs no sessions and no retroactive box-ticking. A beat can point at the playthrough it capped; that run wears a checkered flag, and Stats' <strong>Beaten &amp; Completed</strong> card opens each year into the actual list of what you finished.</p>
      </div>
    </details>

    <details class="qa" id="stats" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'stats')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'stats')!.a}</span>
      </summary>
      <div class="qa__body">
    <p>Every card that shows a breakdown can be turned over. Tap the chart icon in its corner and the card flips between bars and a donut &mdash; Library, Ratings, By System, Genres and Tags. Your choice is remembered per card, and it is kept on the device rather than synced, like the order of the cards themselves.</p>
    <p>Tap a slice, or its row in the legend, and the middle of the ring becomes that slice: its count and its share. Tap again for the total back. The point is not to make you estimate an angle.</p>
    <p>Everything here is built from your own sessions. Nothing is estimated and nothing is borrowed from anyone else's average, which is why a game you have never timed contributes nothing rather than a guess.</p>
      </div>
    </details>

    <details class="qa" id="data" name="qa" data-qa>
      <summary class="qa__s">
        <span class="qa__q">{sections.find((x) => x.id === 'data')!.q}</span>
        <span class="qa__a">{sections.find((x) => x.id === 'data')!.a}</span>
      </summary>
      <div class="qa__body">
    <p><strong>Settings &rarr; Your data &rarr; Export library</strong> writes a readable JSON file covering games, playthroughs, sessions, runs, tracker progress and collections, with a manifest of counts at the top.</p>
    <p>It carries your library's content: games and their metadata, playthroughs, sessions, runs, tracker schemas and progress, your notes, maps and their markers, videos with per-part playlist positions, and collections — each record with its stable id — plus your appearance settings as a single preferences block.</p>
    <p><strong>And it comes back:</strong> Import LevelSelect export (same screen) reads the file and restores whatever your library is missing — never touching what's already there, so an old export merges safely onto a current library, and importing twice changes nothing. One honest caveat remains: map images are saved as links rather than embedded. Alongside it, Recently Deleted holds everything you delete until <em>you</em> decide otherwise — restore with a tap, or use the app's only permanent delete, which lives there and nowhere else.</p>
    <p>There's no lock-in here and there isn't going to be. Your library syncs through your own iCloud, and what's in the export is genuinely yours to take.</p>

    <p class="callout" style="margin-top:2.5rem">Something missing or wrong here? <a href="mailto:support@levelselect.app">support@levelselect.app</a>, or send feedback through TestFlight.</p>
      </div>
    </details>

    </article>
</main>

<script>
  // Opening, not jumping.
  //
  // Every answer used to be expanded, so following a question was a one-way
  // trip: you landed deep in the page and had to scroll back up through
  // everything to reach a second question. Tim: "it jumps all the way down and
  // then I have to scroll all the way back up through everything else to get
  // back to finding my other potential questions."
  //
  // Collapsed, the whole reference is a short list of questions and one-line
  // answers, so the trip back is a few lines rather than a page. A link still
  // has to OPEN its target, though — landing on a closed summary would look
  // like nothing happened.
  const open = (hash: string) => {
    const el = hash && document.querySelector(hash);
    if (!(el instanceof HTMLDetailsElement)) return;
    document.querySelectorAll<HTMLDetailsElement>('.qa[open]')
      .forEach((d) => { if (d !== el) d.open = false; });
    el.open = true;
    el.scrollIntoView({ block: 'start', behavior: 'smooth' });
  };

  open(location.hash);
  window.addEventListener('hashchange', () => open(location.hash));

  // Same-page links skip `hashchange` when the hash is already current, so
  // they are handled directly — otherwise re-clicking a question you have
  // closed does nothing.
  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const hash = (a as HTMLAnchorElement).getAttribute('href')!;
      if (!document.querySelector(hash)) return;
      e.preventDefault();
      history.replaceState(null, '', hash);
      open(hash);
    });
  });
  // Tapping the next question should not move the page under your thumb.
  //
  // Only one answer stays open, so opening the question below a long one
  // deletes that long one from above it, and every pixel it occupied comes off
  // the scroll position — the row you tapped leaps upward and you land further
  // down the list than where you were reading. Tim, opening the question
  // directly beneath a long answer: "collapsing is a little finnicky."
  //
  // The tapped row is the anchor. The toggle is done by hand so that closing
  // the old answer, opening the new one and measuring the difference all
  // happen in one synchronous step — reading the rect forces the layout, so
  // the correction lands in the same frame as the toggle and nothing is ever
  // painted at the wrong offset. (A requestAnimationFrame would be a frame
  // late, and does not run at all in a backgrounded tab.)
  document.querySelectorAll<HTMLElement>('.qa__s').forEach((s) => {
    s.addEventListener('click', (e) => {
      const row = s.parentElement as HTMLDetailsElement;
      e.preventDefault();
      const before = row.getBoundingClientRect().top;
      const wasOpen = row.open;
      document.querySelectorAll<HTMLDetailsElement>('.qa[open]')
        .forEach((d) => { if (d !== row) d.open = false; });
      row.open = !wasOpen;
      const drift = row.getBoundingClientRect().top - before;
      if (drift) window.scrollBy({ top: drift, behavior: 'instant' });
    });
  });

</script>
