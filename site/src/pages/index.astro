---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';

/* **Seven screens, not sixteen.**
 *
 * Fable, 2026-09-22, on the page this replaces: *"The order is a changelog.
 * News and Search lead because they shipped last. The tracker (the product,
 * by the spine) is fourth; 'Yours, privately' — the sentence no competitor
 * can say — is twelfth; Replay isn't on the page."* And: *"One layout,
 * sixteen times… the page still reads as generic because the rhythm is
 * generic."*
 *
 * So the order is the spine now — have, pursue, remember — and the register
 * changes between screens instead of repeating: a paragraph, then a
 * paragraph, then four flat denials, then a grid of twelve.

 *
 * Everything cut is at `/features`, word for word. That content is good; it
 * was in the wrong room.
 *
 * **The hero is deliberately only trimmed, not rebuilt.** Fable: *"Hold the
 * hero redesign until the new icon exists, since the hero is built around
 * it."* The paragraph under the tagline is gone because it repeated the
 * platform line and the privacy claim that screen 4 makes properly; the icon,
 * wordmark, tagline, two buttons and platform line stay until the mark does.
 */

/** Screen 5: twelve two-line tiles, no screenshots. The list is Fable's. */
const rest = [
  { title: 'News about your games',
    body: 'Stories about the games in your library, pulled to the top, with the ones on your wishlist marked. Read one in the app, or save it for later.' },
  { title: 'One search for everything',
    body: 'Your games, every item on every tracker, the line in a note where you wrote it, news and releases — then games you don’t have yet, one tap from Add.' },
  { title: 'A wishlist that counts down',
    body: 'What you’re waiting for, against the date for the platform you picked. A reminder the morning it lands, or up to a week before.' },
  { title: 'Bring in what you already have',
    body: 'Steam, PlayStation, Xbox, itch.io and RetroAchievements, with their playtime where the service keeps it. Or a barcode, or a spreadsheet.' },
  { title: 'Live Activities',
    body: 'The session keeps counting on your Lock Screen while you play, and nudges you if you forget to stop it.' },
  { title: 'Widgets',
    body: 'The timer, the week, and your next objective on the Home Screen — and you can tick that objective off without going anywhere.' },
  { title: 'Siri and Shortcuts',
    body: 'Every game in your library is a Shortcut by name. Wire it into an NFC tag on the console, a Focus, or a scene.' },
  { title: 'Maps, beside the checklist',
    body: 'Keep the map of the place you’re lost in next to the list of what you’re looking for, with your own pins on it.' },
  { title: 'Playthroughs and runs',
    body: 'Separate progress for a second run or NG+. Roguelikes get their own record: loadout, outcome, win rate over time.' },
  { title: 'Collections and shelves',
    body: 'Group a trilogy, a comfort-games list, or everything you own on Genesis. Your library groups by the hardware it lives on, emulators last.' },
  { title: 'Light, dark, and your color',
    body: 'The whole app moves, not just the background. It keeps its own contrast, so no choice you make can hide the text.' },
  { title: 'RetroAchievements',
    body: 'The real achievement set for a retro game — the actual point values, and a warning on the ones you can permanently miss.' },
];
---
<Base
  title="LevelSelect — every game you're playing, and exactly where you left off"
  description="A library, session timer, and progress tracker for people with more games than time. Syncs privately through your own iCloud — no account, no ads, no tracking."
  current="features"
>
<main>
  {/* 1 — Hero. Trimmed, not redesigned; see the note above. */}
  <div class="hero">
    <div class="torchlight"></div>
    <div class="wrap">
      <img class="door" src="/assets/icon.png" width="164" height="164"
           alt="LevelSelect app icon: a torch-lit dungeon door with a checklist" />
      <h1 class="pixel wordmark">LevelSelect</h1>
      <p class="tagline">Every game you're playing, and exactly where you left off.</p>
      <div class="cta">
        <a class="btn btn-primary" href="https://testflight.apple.com/join/7pwdQEMq">Join the beta</a>
        <a class="btn btn-ghost" href="/features/">See everything it does</a>
      </div>
      <p class="badge">iPhone &middot; iPad &middot; Mac &middot; Apple Watch</p>
    </div>
  </div>

  <div class="wrap showcase">
    <Reveal class="hero-devices">
      <img src="/assets/shots/hero-39-29114554.webp" width="2887" height="1645"
           alt="LevelSelect on a MacBook, an iPad and an iPhone, shown at their real sizes. The MacBook shows Home full screen — the profile over this week’s covers, Continue Playing, the systems and the Now Playing shelf. The iPad shows Hollow Knight’s page beside its tracker. The iPhone shows Home with the tabs Home, Library, News and Journal and search beside them." />
    </Reveal>
  </div>

  {/* 2 — The product, second, and stated without mechanics. */}
  <section class="wrap story" id="trackers">
    <Reveal class="story__text">
      <h2>Where you left off</h2>
      <p class="lede">You put a game down for three weeks. LevelSelect is the thing that still knows what you were in the middle of — what you were chasing, how far into it you got, and the note you left yourself about the bit you were stuck on. Not what you own. Where you stopped.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="right">
      <img class="c-front" src="/assets/shots/iphone-39-disco-tasks.webp" width="686" height="1400" loading="lazy"
           alt="Disco Elysium’s Tasks list under its logo: The Hanged Man and Find Your Gun ticked, then Find Your Badge, Call Your Precinct and The Missing Persons Case, each with where in Martinaise it happens." />
      <img class="c-back" src="/assets/shots/iphone-39-home.webp" width="686" height="1400" loading="lazy"
           alt="LevelSelect Home: the profile over this week’s covers, Continue Playing leading with the game most recently put down, and the systems shelf below." />
    </Reveal>
  </section>

  {/* 3 — What it remembers. The first paragraph is the best copy on the old
      page and survives word for word; the mechanics went to /features. */}
  <section class="wrap story story--flip" id="journal">
    <Reveal class="story__text">
      <h2>The part that already happened</h2>
      <p class="lede">You have been writing things down since the first build — a note on a session, what you thought when you finished something. All of it was real, dated and synced, and every word of it was only ever visible inside the sheet you typed it into. The <strong>Journal</strong> is that writing, in order.</p>
      <p class="lede">And it reaches back further than the app does. A <strong>memory</strong> is something that happened before you had this — <em>“Christmas 1995 or 1996”</em> is a real answer, and that is exactly how it is shown.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="left">
      <img class="c-front" src="/assets/shots/iphone-39-journal-timeline.webp" width="686" height="1400" loading="lazy"
           alt="The Journal timeline on iPhone: today and yesterday’s sessions of Hades and Hollow Knight, each a single row for the day, then earlier in the week." />
      <img class="c-back" src="/assets/shots/iphone-39-memory-photos.webp" width="686" height="1400" loading="lazy"
           alt="A single memory opened: First time playing Halo 2, 13 November 2004, the note “Multiplayer with Marcus, Priya, and Devin”, and three screenshots, one large above two smaller." />
    </Reveal>
  </section>

  {/* 4 — Twelfth on the old page. The one thing no competitor can say. */}
  <section class="wrap" id="privately">
    <Reveal class="private">
      <h2>Yours, privately</h2>
      <p class="lede">Most trackers start by asking you to log in to PlayStation, and Xbox, and Steam, and Nintendo — handing over an account for every shelf you own.</p>
      <p class="lede">LevelSelect never asks for one. Your library lives on your device and syncs through your own iCloud, where it is yours in the ordinary sense of the word.</p>
      <ul class="nots">
        <li>No account to create</li>
        <li>No ads</li>
        <li>No analytics, no tracking</li>
        <li>Export the whole thing as readable JSON, whenever</li>
      </ul>
      <p class="beta-note">The one exception is spelled out in full: <a href="/privacy/">how your data works</a>.</p>
    </Reveal>
  </section>

  {/* 5 — Twelve tiles absorb the ten sections that used to sit above. */}
  <section class="wrap" id="features">
    <Reveal>
      <h2>And the rest of it</h2>
      <p class="lede">The things you'd otherwise keep in your head, or a notes app, or nowhere. <a href="/features/">All of it in detail &rarr;</a></p>
    </Reveal>
    <div class="grid">
      {rest.map((f) => (
        <Reveal class="tile">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </Reveal>
      ))}
    </div>
  </section>

  {/* 6 — Get it. */}
  <section class="wrap" id="beta">
    <Reveal class="card-hero beta-card">
      <h2>The beta is open</h2>
      <p class="lede">LevelSelect is in open testing on iPhone, iPad, Mac, and Apple Watch. The link below installs it — you'll need TestFlight, and it installs that too if you don't have it. No form, no waiting. Bugs and blunt opinions equally welcome.</p>
      <a class="btn btn-primary" href="https://testflight.apple.com/join/7pwdQEMq">Join the beta</a>
      <p class="beta-note"><a href="/changelog/">See what's changed</a> &middot; <a href="/roadmap/">where it's going</a></p>
    </Reveal>
  </section>
</main>

<style is:global>
  /* Layout-only additions for the new sections. Everything else still comes
     from the hand-written stylesheet in /assets/style.css. */
  .beta-card { display: block; text-align: center; }
  .beta-card h2 { margin-bottom: .4rem; }
  .beta-card .lede { margin: 0 auto 1.2rem; }
  .beta-note { margin: 1rem 0 0; font-size: .9rem; }
</style>
</Base>
