---
import Base from '../../layouts/Base.astro';
import { shipped, horizons, notPlanned, reviewed } from '../../data/roadmap';
---
<Base
  title="Roadmap — LevelSelect"
  description="Where LevelSelect is going: what's being worked on now, what's next, and what's being explored."
  current="roadmap"
>
<main class="wrap">
  <article class="doc doc--wide">
    <h1>Roadmap</h1>
    <p class="stamp">Last reviewed {reviewed} &middot; a direction, not a set of promises</p>

    <div class="board">
      {/* First, because the board reads left to right from done to maybe, and
          a column of things that actually happened is what gives the three
          columns of intentions beside it any weight. Every card is a link into
          the build that delivered it — a kept promise you can go and read. */}
      <section class="col">
        <header class="col__head">
          <span class="col__dot" style="background:#FF9F0A"></span>
          <h2 class="col__name">Shipped</h2>
          <span class="col__note">done</span>
          <span class="col__n">{shipped.length}</span>
        </header>
        {shipped.map((item) => (
          <a class="rcard rcard--done" style="--stripe:#FF9F0A" href={`/changelog/#build-${item.build}`}>
            <b>{item.t}</b>
            <span>{item.d}</span>
            <span class="rcard__build">Build {item.build} &rarr;</span>
          </a>
        ))}
      </section>

      {horizons.map((h) => (
        <section class="col">
          <header class="col__head">
            <span class="col__dot" style={`background:${h.color}`}></span>
            <h2 class="col__name">{h.name}</h2>
            <span class="col__note">{h.note}</span>
            <span class="col__n">{h.items.length}</span>
          </header>
          {h.items.map((item) => (
            <div class="rcard" style={`--stripe:${h.color}`}>
              <b>{item.t}</b>
              <span>{item.d}</span>
            </div>
          ))}
        </section>
      ))}
    </div>

    {/* Deliberately given equal weight rather than tucked at the bottom as
        prose: for this app the absences are a large part of the pitch. */}
    <section class="col col--off">
      <header class="col__head">
        <span class="col__dot col__dot--off"></span>
        <h2 class="col__name">Not planned</h2>
        <span class="col__note">on purpose</span>
      </header>
      <div class="notgrid">
        {notPlanned.map((item) => (
          <div class="rcard rcard--off">
            <b>{item.t}</b>
            <span>{item.d}</span>
          </div>
        ))}
      </div>
    </section>

    <p class="stamp" style="margin-top:2rem">
      For what's already shipped, see the <a href="/changelog/">changelog</a>.
    </p>
  </article>
</main>

<style>
  /* The board wants more room than the reading measure allows. */
  .doc--wide { max-width: 1080px; }

  .board { display: grid; gap: 1.6rem; margin-top: 1.8rem; }
  @media (min-width: 860px) {
    .board { grid-template-columns: repeat(2, 1fr); gap: 1.4rem; align-items: start; }
  }
  @media (min-width: 1180px) {
    .board { grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  }

  /* A shipped card is a link; it must not read as a dead card, or as a button. */
  .rcard--done { text-decoration: none; color: inherit; display: block; }
  .rcard--done:hover { background: rgba(255, 255, 255, .07); border-color: #FF9F0A; }
  .rcard--done:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rcard__build {
    display: block; margin-top: .45rem;
    font-size: .72rem; font-weight: 700; letter-spacing: .02em;
    color: #FF9F0A;
  }

  .col__head {
    display: flex; align-items: center; gap: .5rem;
    padding-bottom: .55rem; margin-bottom: .7rem;
    border-bottom: 1px solid var(--line);
  }
  .col__dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .col__dot--off { background: var(--muted); opacity: .5; }
  .col__name {
    font-size: .78rem; text-transform: uppercase; letter-spacing: .09em;
    margin: 0; font-weight: 700;
  }
  .col__note { font-size: .78rem; color: var(--muted); }
  .col__n {
    margin-left: auto; font-size: .74rem; color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-variant-numeric: tabular-nums;
  }

  .rcard {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, .045);
    padding: .8rem .9rem .8rem 1.05rem;
    margin-bottom: .6rem;
    overflow: hidden;
  }
  /* A stripe rather than a full tint — the status stays legible when three
     columns sit side by side without three colored blocks fighting. */
  .rcard::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px; background: var(--stripe, var(--muted));
  }
  .rcard b { display: block; font-size: .97rem; font-weight: 650; }
  .rcard span { display: block; color: var(--muted); font-size: .88rem; margin-top: .2rem; }

  .col--off { margin-top: 2.6rem; }
  .notgrid { display: grid; gap: .6rem; }
  @media (min-width: 860px) { .notgrid { grid-template-columns: repeat(3, 1fr); } }
  .rcard--off { opacity: .62; margin-bottom: 0; }
  .rcard--off::before { background: var(--muted); opacity: .4; }
  .rcard--off b { text-decoration: line-through; text-decoration-color: var(--muted); }
</style>
</Base>
