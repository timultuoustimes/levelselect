---
import Base from '../../layouts/Base.astro';

const shipped = [
  { t: 'Library and Wishlist, with an identity of their own', build: 34,
    d: 'Status, system and ownership all on screen, and a wishlist that knows what is out.' },
  { t: 'Every platform a game came out on', build: 34,
    d: 'Mark the ones you own it on, rather than the app knowing only the one you typed.' },
  { t: 'Your own cover art', build: 31,
    d: 'The cover can be the one your copy had.' },
  { t: 'A safety net for deletions', build: 28,
    d: 'Recently Deleted and a restore path, so nothing is ever one tap from gone.' },
  { t: 'Deeper stats', build: 27,
    d: 'Your habits by year, by genre, by system — and cards you can rearrange.' },
  { t: 'Build a tracker piece by piece', build: 25,
    d: 'Fill one category at a time instead of waiting on one generation that can fail entirely.' },
];

const horizons = [
  {
    key: 'now',
    name: 'Now',
    note: 'being worked on',
    color: '#30D158',
    items: [
      { t: 'Settling the beta', d: 'Making the things people use every day dependable before adding more.' },
      { t: 'Trackers you can trust', d: "Generating a tracker should never be a gamble with progress you've already made." },
      { t: 'Mac polish', d: "Underway. The Mac app has the new design and reachable settings now; the details still lag the iPhone." },
      { t: 'Stats', d: "Home, the game page, Library and Wishlist all have an identity of their own now. Stats is the last page still waiting for the same treatment." },
    ],
  },
  {
    key: 'next',
    name: 'Next',
    note: 'planned',
    color: '#0A84FF',
    items: [
      { t: 'Moments worth celebrating', d: 'Finishing a game or hitting a milestone should feel like something.' },
      { t: 'Replays', d: 'A look back at a month, a quarter or a year, built from your own library on your own device.' },
      { t: 'A notebook, not just a tracker', d: 'Somewhere to write about a game and read it back later, in the order it happened.' },
      { t: 'itch.io games', d: "Tracked properly, including the many that have no IGDB entry at all — which is the case an IGDB-first app handles worst." },
      { t: 'More to go on when adding a game', d: 'A trailer, screenshots and a description, so you can tell whether it is the right game — or worth adding at all — without already knowing it.' },
    ],
  },
  {
    key: 'exploring',
    name: 'Exploring',
    note: 'no commitment',
    color: '#BF5AF2',
    items: [
      { t: 'Badges', d: "Recognition for what you've actually done, earned once and kept." },
      { t: 'Scanning a written list', d: 'Point a camera at a checklist you wrote by hand and turn it into a tracker.' },
      { t: 'More ways to bring a library in', d: 'Beyond CSV.' },
      { t: 'Game news, in its own place', d: 'A reader for releases and news you choose to follow — a separate tab, not a feed bolted onto the shelf you came to look at.' },
      { t: 'More of your own notebook', d: 'Themes, icons, and the sort of personality a paper journal has.' },
    ],
  },
];

const notPlanned = [
  { t: 'Accounts', d: "Your library lives in your own iCloud. There's nothing to sign up for." },
  { t: 'Ads, analytics or tracking', d: 'Not now, not later.' },
  { t: 'A social network', d: 'Sharing something you choose to share is one thing; a feed is another.' },
];
---
<Base
  title="Roadmap — LevelSelect"
  description="Where LevelSelect is going: what's being worked on now, what's next, and what's being explored."
  current="roadmap"
>
<main class="wrap">
  <article class="doc doc--wide">
    <h1>Roadmap</h1>
    <p class="stamp">Last reviewed 1 September 2026 &middot; a direction, not a set of promises</p>

    <div class="board">
      {/* First, because the board reads left to right from done to maybe, and
          a column of things that actually happened is what gives the three
          columns of intentions beside it any weight. Every card is a link into
          the build that delivered it — a kept promise you can go and read. */}
      <section class="col">
        <header class="col__head">
          <span class="col__dot" style="background:#FF9F0A"></span>
          <h2 class="col__name">Shipped</h2>
          <span class="col__note">done</span>
          <span class="col__n">{shipped.length}</span>
        </header>
        {shipped.map((item) => (
          <a class="rcard rcard--done" style="--stripe:#FF9F0A" href={`/changelog/#build-${item.build}`}>
            <b>{item.t}</b>
            <span>{item.d}</span>
            <span class="rcard__build">Build {item.build} &rarr;</span>
          </a>
        ))}
      </section>

      {horizons.map((h) => (
        <section class="col">
          <header class="col__head">
            <span class="col__dot" style={`background:${h.color}`}></span>
            <h2 class="col__name">{h.name}</h2>
            <span class="col__note">{h.note}</span>
            <span class="col__n">{h.items.length}</span>
          </header>
          {h.items.map((item) => (
            <div class="rcard" style={`--stripe:${h.color}`}>
              <b>{item.t}</b>
              <span>{item.d}</span>
            </div>
          ))}
        </section>
      ))}
    </div>

    {/* Deliberately given equal weight rather than tucked at the bottom as
        prose: for this app the absences are a large part of the pitch. */}
    <section class="col col--off">
      <header class="col__head">
        <span class="col__dot col__dot--off"></span>
        <h2 class="col__name">Not planned</h2>
        <span class="col__note">on purpose</span>
      </header>
      <div class="notgrid">
        {notPlanned.map((item) => (
          <div class="rcard rcard--off">
            <b>{item.t}</b>
            <span>{item.d}</span>
          </div>
        ))}
      </div>
    </section>

    <p class="stamp" style="margin-top:2rem">
      For what's already shipped, see the <a href="/changelog/">changelog</a>.
    </p>
  </article>
</main>

<style>
  /* The board wants more room than the reading measure allows. */
  .doc--wide { max-width: 1080px; }

  .board { display: grid; gap: 1.6rem; margin-top: 1.8rem; }
  @media (min-width: 860px) {
    .board { grid-template-columns: repeat(2, 1fr); gap: 1.4rem; align-items: start; }
  }
  @media (min-width: 1180px) {
    .board { grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  }

  /* A shipped card is a link; it must not read as a dead card, or as a button. */
  .rcard--done { text-decoration: none; color: inherit; display: block; }
  .rcard--done:hover { background: rgba(255, 255, 255, .07); border-color: #FF9F0A; }
  .rcard--done:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rcard__build {
    display: block; margin-top: .45rem;
    font-size: .72rem; font-weight: 700; letter-spacing: .02em;
    color: #FF9F0A;
  }

  .col__head {
    display: flex; align-items: center; gap: .5rem;
    padding-bottom: .55rem; margin-bottom: .7rem;
    border-bottom: 1px solid var(--line);
  }
  .col__dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .col__dot--off { background: var(--muted); opacity: .5; }
  .col__name {
    font-size: .78rem; text-transform: uppercase; letter-spacing: .09em;
    margin: 0; font-weight: 700;
  }
  .col__note { font-size: .78rem; color: var(--muted); }
  .col__n {
    margin-left: auto; font-size: .74rem; color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-variant-numeric: tabular-nums;
  }

  .rcard {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, .045);
    padding: .8rem .9rem .8rem 1.05rem;
    margin-bottom: .6rem;
    overflow: hidden;
  }
  /* A stripe rather than a full tint — the status stays legible when three
     columns sit side by side without three colored blocks fighting. */
  .rcard::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px; background: var(--stripe, var(--muted));
  }
  .rcard b { display: block; font-size: .97rem; font-weight: 650; }
  .rcard span { display: block; color: var(--muted); font-size: .88rem; margin-top: .2rem; }

  .col--off { margin-top: 2.6rem; }
  .notgrid { display: grid; gap: .6rem; }
  @media (min-width: 860px) { .notgrid { grid-template-columns: repeat(3, 1fr); } }
  .rcard--off { opacity: .62; margin-bottom: 0; }
  .rcard--off::before { background: var(--muted); opacity: .4; }
  .rcard--off b { text-decoration: line-through; text-decoration-color: var(--muted); }
</style>
</Base>
