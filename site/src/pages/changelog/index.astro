---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

// Drafts show in Netlify deploy previews, marked, so a build's notes can be
// read on the preview before they're published — and never on the live site,
// which is the only place CONTEXT is "production". The RSS feed and the app's
// feed.json keep hiding drafts everywhere.
const showDrafts = process.env.CONTEXT === 'deploy-preview' || process.env.CONTEXT === 'branch-deploy';
/** The build number out of an id: `0.1.0-32` → 32, and `0.1.0-beta` → 0. */
const buildNo = (id: string) => Number(id.split('-').pop()) || 0;

// Newest first, and where two builds went out on the same day the higher
// number is the later one. Date alone left 31 sitting above 32 (both 27
// August), which reads as a mistake in a list whose whole job is order.
const entries = (await getCollection('changelog', ({ data }) => showDrafts || !data.draft))
  .sort((a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || buildNo(b.id) - buildNo(a.id));

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

/**
 * A release needs a name you can link at.
 *
 * The roadmap points here to say "this one shipped, in this build" — a
 * promise is worth more when you can read what became of it. The id is
 * derived rather than added to the frontmatter so a new entry cannot forget
 * to have one: 0.1.0-34 becomes build-34, and 0.1.0-beta becomes build-beta.
 */
const anchorFor = (id: string) => `build-${id.split('-').pop()}`;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

/**
 * **The index, once the list is too long to scan.**
 *
 * Fable, 2026-09-22: *"A version index once there are more than ~6 entries:
 * year → build → one line, each a link."* There are twenty, and every one of
 * them is a collapsed heading you have to read in order to find the build you
 * came for. The index is the only way to arrive at a specific build without
 * scrolling the whole history.
 *
 * Years rather than a flat list because the numbering is about to stop being
 * monotonic in a readable way — `0.1.0 (40)` becomes `1.0` — and a date is
 * the one thing that stays sortable across that change.
 */
const byYear = entries.reduce<Record<string, typeof entries>>((acc, entry) => {
  const year = String(entry.data.date.getFullYear());
  (acc[year] ??= []).push(entry);
  return acc;
}, {});
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const shortDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---
<Base
  title="Changelog — LevelSelect"
  description="What's actually shipped in the LevelSelect beta, build by build."
  current="changelog"
>
<main class="wrap">
  <article class="doc">
    <h1>Changelog</h1>
    <p class="stamp">
      What's shipped, newest first. <a href="/changelog/rss.xml">RSS</a>
    </p>

    {/* The filter is the whole point of this layout: it lets someone decide NOT
        to read most of the page. Progressive enhancement — the chips only
        appear once the script that makes them work has run, so a no-JS reader
        gets the full list rather than dead buttons. */}
    <div class="filters" data-filters hidden>
      <button class="fchip" aria-pressed="true" data-f="all">Everything</button>
      <button class="fchip" aria-pressed="false" data-f="new"><i class="d d--new"></i>New</button>
      <button class="fchip" aria-pressed="false" data-f="improved"><i class="d d--improved"></i>Improved</button>
      <button class="fchip" aria-pressed="false" data-f="fixed"><i class="d d--fixed"></i>Fixed</button>
    </div>

    {/* Hidden while a filter is active: the index points at builds, and a
        filtered page is a list of changes, so its links would jump to
        headings whose bodies are mostly gone. */}
    <nav class="vindex" aria-label="Jump to a build" data-hide-when-filtering>
      {years.map((year) => (
        <div class="vindex__year">
          <h2 class="vindex__y">{year}</h2>
          <ul>
            {byYear[year].map((entry) => (
              <li>
                <a href={`#${anchorFor(entry.id)}`}>
                  <span class="vindex__v">{entry.data.version}</span>
                  <span class="vindex__t">{entry.data.title}</span>
                  <span class="vindex__d">{shortDate(entry.data.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    {rendered.map(({ entry, Content }, i) => (
      <section class="release" id={anchorFor(entry.id)} data-release data-open={i === 0 ? 'true' : 'false'}>
        <button class="release__top" data-release-toggle aria-expanded={i === 0 ? 'true' : 'false'}>
          <span class="release__caret" aria-hidden="true">›</span>
          <span class="release__head">
            <span class="release__title">{entry.data.title}</span>
            <span class="release__meta">
              <span class="release__version">{entry.data.version}</span>
              {entry.data.draft && <span class="release__version" style="color:#FF9F0A">Draft — preview only</span>}
              <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
            </span>
          </span>
        </button>
        <div class="release__body" data-release-body hidden={i !== 0}>
          <p class="release__summary">{entry.data.summary}</p>
          <div class="release__content"><Content /></div>
        </div>
      </section>
    ))}

    <p class="callout" style="margin-top:2rem">
      Everything here ships to TestFlight as it's ready, and the beta is open — <a href="https://testflight.apple.com/join/7pwdQEMq">join it here</a>. Builds go out when they're ready, not on a schedule.
    </p>
  </article>
</main>

<script>
  const bar = document.querySelector('[data-filters]') as HTMLElement | null;
  if (bar) bar.hidden = false;

  // Follow a link to one release.
  //
  // Only the newest is open, so landing on #build-28 from the roadmap would
  // otherwise show a closed title and look like the link was broken. Opening
  // the target is the whole point of having linked to it.
  const openRelease = (hash: string) => {
    const el = hash && document.querySelector(hash);
    if (!(el instanceof HTMLElement) || !el.matches('[data-release]')) return;
    const body = el.querySelector('[data-release-body]') as HTMLElement;
    const btn = el.querySelector('[data-release-toggle]') as HTMLElement;
    el.dataset.open = 'true';
    btn?.setAttribute('aria-expanded', 'true');
    if (body) body.hidden = false;
    el.scrollIntoView({ block: 'start', behavior: 'smooth' });
  };

  openRelease(location.hash);
  window.addEventListener('hashchange', () => openRelease(location.hash));

  // Expand / collapse
  document.querySelectorAll('[data-release-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const release = btn.closest('[data-release]') as HTMLElement;
      const body = release.querySelector('[data-release-body]') as HTMLElement;
      const open = release.dataset.open === 'true';
      release.dataset.open = String(!open);
      btn.setAttribute('aria-expanded', String(!open));
      body.hidden = open;
    });
  });

  // Filter by change kind.
  //
  // This used to take the kind from the heading TEXT, expecting <h3>New</h3>,
  // <h3>Improved</h3>, <h3>Fixed</h3>. No entry has ever been written that way
  // — they use descriptive headings like "A profile" and "Smaller things",
  // which is the better writing and the reason the changelog reads like prose
  // rather than a release note. So `kind` was always something like
  // "a profile", nothing ever matched a chip, and picking anything but
  // Everything emptied the page. The chips have never worked.
  //
  // A heading now declares its kind with a trailing marker the reader never
  // sees — "### Smaller things [improved]" — and anything untagged is `new`,
  // which is what a section describing a feature is. Explicit beats inferring
  // intent from prose: "Smaller things" holds fixes in one entry and polish in
  // another, and no heuristic can tell them apart.
  const KINDS = ['new', 'improved', 'fixed'];
  document.querySelectorAll('.release__content').forEach((content) => {
    let kind = 'new';
    [...content.children].forEach((el) => {
      if (el.tagName === 'H3') {
        const text = el.textContent!.trim();
        const tag = text.match(/\s*\[(\w+)\]$/);
        if (tag && KINDS.includes(tag[1].toLowerCase())) {
          kind = tag[1].toLowerCase();
          el.textContent = text.slice(0, tag.index).trim();
        } else {
          kind = 'new';
        }
      }
      (el as HTMLElement).dataset.kind = kind;
    });
  });

  bar?.querySelectorAll('.fchip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const f = (chip as HTMLElement).dataset.f!;
      bar.querySelectorAll('.fchip').forEach((c) =>
        c.setAttribute('aria-pressed', String(c === chip))
      );
      // The index points at builds. Filtered, the page is a list of changes
      // rather than of builds, so its links would land on headings whose
      // bodies are mostly hidden.
      document.querySelectorAll('[data-hide-when-filtering]').forEach((el) => {
        (el as HTMLElement).hidden = f !== 'all';
      });
      document.querySelectorAll('.release').forEach((release) => {
        let shown = 0;
        release.querySelectorAll('.release__content > *').forEach((el) => {
          const match = f === 'all' || (el as HTMLElement).dataset.kind === f;
          (el as HTMLElement).hidden = !match;
          if (match && el.tagName !== 'H3') shown++;
        });
        // A release with nothing matching steps back rather than disappearing —
        // "nothing here" is information too.
        (release as HTMLElement).dataset.empty = String(shown === 0 && f !== 'all');
        if (f !== 'all' && shown > 0) {
          (release as HTMLElement).dataset.open = 'true';
          (release.querySelector('[data-release-body]') as HTMLElement).hidden = false;
          release.querySelector('[data-release-toggle]')!.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

<style>
  /* ── the version index ───────────────────────────────
     A list, not cards: it is a table of contents and it competes with the
     releases below it if it is given any weight of its own. */
  .vindex { margin: 0 0 2.4rem; }
  .vindex__year + .vindex__year { margin-top: 1.2rem; }
  .vindex__y {
    font-size: .8rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 .4rem; font-weight: 600;
  }
  .vindex ul { list-style: none; margin: 0; padding: 0; }
  .vindex li + li { border-top: 1px solid var(--line); }
  .vindex a {
    display: grid; grid-template-columns: 5.5rem 1fr auto;
    gap: .75rem; align-items: baseline;
    padding: .45rem .2rem; text-decoration: none; color: var(--ink);
    border-radius: 6px;
  }
  .vindex a:hover { background: rgba(255, 255, 255, .05); color: var(--ink); }
  .vindex__v { color: var(--muted); font-variant-numeric: tabular-nums; font-size: .85rem; }
  .vindex__t { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vindex__d { color: var(--muted); font-size: .8rem; white-space: nowrap; }
  /* On a phone the title is the only part worth the width. */
  @media (max-width: 560px) {
    .vindex a { grid-template-columns: 1fr auto; row-gap: 0; }
    .vindex__v { grid-column: 1 / -1; order: -1; font-size: .75rem; }
  }

  .filters { display: flex; gap: .4rem; flex-wrap: wrap; margin: 1.4rem 0 1.8rem; }
  .fchip {
    font: inherit; font-size: .82rem;
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .35rem .75rem; border-radius: 999px;
    border: 1px solid var(--line); background: transparent;
    color: var(--muted); cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .fchip[aria-pressed='true'] {
    background: var(--accent); border-color: var(--accent);
    color: var(--on-accent); font-weight: 650;
  }
  .fchip[aria-pressed='true'] .d { background: #12081F; }
  .fchip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .d { width: 7px; height: 7px; border-radius: 50%; display: block; flex: none; }
  .d--new { background: #30D158; }
  .d--improved { background: #0A84FF; }
  .d--fixed { background: #FF9F0A; }

  .release {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, .04);
    margin-bottom: .7rem;
    overflow: hidden;
    transition: opacity 200ms ease;
    /* A release linked from the roadmap must not land under the site header. */
    scroll-margin-top: 5rem;
  }
  .release[data-empty='true'] { opacity: .35; }

  .release__top {
    display: flex; align-items: flex-start; gap: .7rem;
    width: 100%; padding: .95rem 1.05rem;
    background: none; border: 0; color: inherit; font: inherit;
    text-align: left; cursor: pointer;
  }
  .release__top:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .release__caret {
    color: var(--muted); flex: none; line-height: 1.4;
    transition: transform 200ms ease;
  }
  .release[data-open='true'] .release__caret { transform: rotate(90deg); }
  .release__head { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .release__title { font-size: 1.05rem; font-weight: 650; }
  .release__meta { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; font-size: .82rem; color: var(--muted); }
  .release__version {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: .72rem; padding: .16rem .42rem;
    border: 1px solid var(--line); border-radius: 5px;
  }

  .release__body { padding: 0 1.05rem 1rem 2.4rem; }
  .release__summary { color: var(--ink); margin: 0 0 .9rem; }

  /* The markdown's own <h3>New/Improved/Fixed</h3> become colored labels. */
  .release__content :global(h3) {
    font-size: .74rem; text-transform: uppercase; letter-spacing: .07em;
    color: var(--muted); margin: 1.3rem 0 .4rem;
    display: flex; align-items: center; gap: .45rem;
  }
  .release__content :global(h3)::before {
    content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--muted);
  }
  /* Kind is tagged by the script, so a no-JS reader gets neutral dots rather
     than none — the labels still read. */
  .release__content :global(h3[data-kind='new'])::before { background: #30D158; }
  .release__content :global(h3[data-kind='improved'])::before { background: #0A84FF; }
  .release__content :global(h3[data-kind='fixed'])::before { background: #FF9F0A; }
  .release__content :global(h3:first-child) { margin-top: 0; }
  .release__content :global(ul) { margin: 0; padding-left: 1.15rem; }
  .release__content :global(li) { margin: .35rem 0; }

  @media (max-width: 560px) {
    .release__body { padding-left: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .release, .release__caret, .fchip { transition: none; }
  }
</style>
</Base>
