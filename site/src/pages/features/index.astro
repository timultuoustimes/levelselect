---
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/Reveal.astro';
import StageDemo from '../../components/StageDemo.astro';

/* **The long form.** The homepage used to be sixteen of these sections, which
   made it a changelog in page order: News and Search led because they shipped
   last, the tracker was fourth, and "Yours, privately" — the sentence no
   competitor can say — was twelfth.

   Fable, 2026-09-22: *"Everything cut goes to a real /features page in the
   current form — that content is good, it's in the wrong room."* So this is
   that room. The sections are moved WORD FOR WORD; only their order changed,
   to read as a tour rather than as a release history: what a game page is,
   what you do on it, what the app remembers, and where it runs.

   Two deliberate omissions from what used to be here:

   - **RetroAchievements is sold once**, here, in "Games older than the app".
     The homepage tracker section sold it too, nearly verbatim.
   - **"Sorted by system" is gone entirely.** It showcased the generated
     placeholder console images as though they were the feature. They are
     placeholders; the library grouping they illustrated is a line in the
     Collections tile on the homepage instead. */

/* The generation triptych. Three frames because the feature is a sequence —
   a single still of it is just a spinner. */
const steps = [
  {
    img: 'iphone-39-disco-planned.webp',
    cap: 'Ask what the game is made of.',
    alt: 'Disco Elysium\u2019s tracker planned for 100 percent: seven categories \u2014 Thoughts, Tasks, Checks, Dialogues and more \u2014 each marked Planned with its own Generate button.',
  },
  {
    img: 'iphone-39-disco-generating.webp',
    cap: 'Fill one category. Leave the rest planned.',
    alt: '"Looking for a guide to Tasks \u2014 one category only, so this is quicker than a full tracker" running above Quests, Thoughts, Skill Checks and Dialogues, each still marked Planned with its own Generate button.',
  },
  {
    img: 'iphone-39-disco-tasks.webp',
    cap: 'Come back for the next one whenever.',
    alt: 'The finished Tasks list \u2014 The Hanged Man, Find Your Gun, Call Your Precinct \u2014 each with where it happens, two already ticked.',
  },
];
---
<Base
  title="Features — LevelSelect"
  description="The long form: game pages, trackers built a piece at a time, sessions and widgets, news, search, the calendar, light mode, RetroAchievements, and the iPad stage."
  current="features"
>
<main>
  <section class="wrap">
    <Reveal>
      <h1>Features</h1>
      <p class="lede">The whole tour, in detail. If you want the short version, it is <a href="/">the front page</a>.</p>
    </Reveal>
  </section>

  <section class="wrap story story--flip" id="gamepage">
    <Reveal class="story__text">
      <h2>A page that looks like the game</h2>
      <p class="lede">Every game gets its own key art across the top and its own logo where a title would be, so the page you open looks like the thing you played rather than like a database row.</p>
      <p class="lede">Underneath: what you scored it, what the critics said, and how long you have actually spent on it — across every playthrough, not just the current one. Turn that row off if you don't time your play.</p>
      <p class="lede">And four ways to arrange it. <strong>Showcase</strong> leads with the art, <strong>Classic</strong> keeps the plain original, <strong>Cover</strong> puts the box first, and <strong>Compact</strong> is nearly all list. Pick the one that suits how you read a page.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="left">
      <img class="c-front" src="/assets/shots/iphone-39-layout-showcase.webp" width="686" height="1400" loading="lazy"
           alt="The Hollow Knight game page in the Showcase layout: its own key art filling the header, the cover above the game’s logo where a title would be, five stars, Now Playing on Switch, and a row reading 44 hours 37 minutes played across 17 sessions." />
      <img class="c-back" src="/assets/shots/iphone-39-layout-classic.webp" width="686" height="1400" loading="lazy"
           alt="The same game arranged as Classic: the cover beside its details rather than under the art, Now Playing on Switch, five stars, and the Sessions list open beneath with a Start Session button." />
    </Reveal>
  </section>

  <section class="wrap" id="generate">
    <Reveal>
      <h2>Built one piece at a time</h2>
      <p class="lede">Planning a tracker starts by asking what it's for: just the story, a simple checklist, your party, or everything for 100%. You get a plan, not a wall. Fill in the categories you care about now and leave the rest planned until you want them. A list can be a roster of your party, count nine hundred Korok Seeds as one row, or be left out of this run entirely.</p>
    </Reveal>
    <div class="steps">
      {steps.map((s, i) => (
        <Reveal class="step">
          <div class="shot">
            <img src={`/assets/shots/${s.img}`} width="686" height="1400" loading="lazy" alt={s.alt} />
          </div>
          <p><b>{i + 1}.</b> {s.cap}</p>
        </Reveal>
      ))}
    </div>
    <p class="steps__legend">{steps.map((s, i) => `${i + 1}. ${s.cap}`).join('  ·  ')}</p>
  </section>

  <section class="wrap story story--flip" id="sessions">
    <Reveal class="story__text">
      <h2>Start a session without opening the app</h2>
      <p class="lede">The Live Activity keeps counting on your Lock Screen while you play, and nudges you if you forget to stop it. Widgets put the timer, the week, and your next objective on the Home Screen — and you can tick that objective off without going anywhere.</p>
      <p class="lede"><b>Your games are Shortcuts too.</b> Say <i>"Start a session for Hollow Knight in LevelSelect"</i> and it starts timing. Every game in your library is available to Siri, Spotlight and the Shortcuts app by name, so you can wire it into whatever you already use — an NFC tag on the console, a Focus, a scene.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="left">
      <img class="c-front" src="/assets/shots/iphone-05-lock-screen-live-activity.webp" width="686" height="1400" loading="lazy"
           alt="Lock Screen showing a LevelSelect widget with Hollow Knight at 57 percent and a Live Activity counting a session at 7 minutes 46 seconds." />
      <img class="c-back" src="/assets/shots/iphone-07-home-screen-widgets.webp" width="686" height="1400" loading="lazy"
           alt="Home Screen with LevelSelect widgets: Hollow Knight playing with its next objective, a Now Playing row, 139 hours this week, and a completion ring." />
    </Reveal>
  </section>

  <section class="wrap story" id="waiting">
    <Reveal class="story__text">
      <h2>A game you're waiting for tells you when</h2>
      <p class="lede">The wishlist counts down. <strong>"Tomorrow"</strong> when it's close, the date itself once it's further off — and it's <em>your</em> date: a game out on PC and months away on Switch 2 has two true answers, and you see the one for the platform you picked.</p>
      <p class="lede">Three shelves, because a wishlist that quietly drops half of itself is lying about what you're waiting for: <strong>Coming soon</strong> for the ones with a real date, <strong>No date yet</strong> for the announced, and <strong>Out now</strong> for the ones you can go and buy.</p>
      <p class="lede">On the Home Screen, <strong>Coming Soon</strong> lists what's next with the wait under each, and <strong>Release Calendar</strong> draws a real month with covers standing where the day numbers would be. A reminder arrives at 9am on the day, or up to a week before — a release is a date, so firing <em>at</em> it would wake you for a game that isn't out where you are yet.</p>
      <p class="lede">The game's own page carries the rest: its trailers and screenshots, playable without leaving the app, and every platform it is coming to with its own date beside it.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="left">
      <img class="c-front" src="/assets/shots/iphone-39-release-dates.webp" width="686" height="1400" loading="lazy"
           alt="Control Resonant\u2019s Game Info in LevelSelect: every platform with its own date \u2014 Mac, PC, PS5 and Xbox Series on 24 September, each in 6 days \u2014 and Mac marked MINE. " />
      <img class="c-back" src="/assets/shots/iphone-36-release-widgets.webp" width="686" height="1400" loading="lazy"
           alt="Two LevelSelect widgets on the Home Screen: a Release Calendar list reading Onimusha tomorrow and two more in two weeks, and a September month grid with each game\u2019s cover sitting on the day it arrives." />
    </Reveal>
  </section>

  <section class="wrap story" id="news">
    <Reveal class="story__text">
      <h2>News about the games you have</h2>
      <p class="lede">A <strong>News</strong> tab of the sites you choose, with the stories about games in your library pulled to the top and the ones on your wishlist marked. Read one in reader mode without leaving the app, or save it for later.</p>
      <p class="lede"><strong>New &amp; Upcoming</strong> is every game coming out on the systems you pick, the next one counted down in days — and the ones that just came out, so a release you missed doesn’t stay missed.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="right">
      <img class="c-front" src="/assets/shots/iphone-39-news.webp" width="686" height="1400" loading="lazy"
           alt="The News tab: For You selected, About your games leading with a story about a game on your wishlist, then Picked for you with a four-days countdown to a wishlisted release." />
      <img class="c-back" src="/assets/shots/iphone-39-upcoming.webp" width="686" height="1400" loading="lazy"
           alt="New &amp; Upcoming: Up next with covers counting down — Today, 4 days, 6 days — then Just out, each dated and marked with the systems it came to." />
    </Reveal>
  </section>

  <section class="wrap story story--flip" id="search">
    <Reveal class="story__text">
      <h2>One search for everything</h2>
      <p class="lede">Search sits in its own circle beside the tab bar. One field finds your games, every item on every tracker, the line in a note where you wrote it, news stories and upcoming releases — then games you don’t have, one tap from Add.</p>
      <p class="lede">And the <strong>Wishlist</strong> moved in with the Library: one tab, two halves, because a wishlist is just the games you’re hoping to own.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="left">
      <img class="c-front" src="/assets/shots/iphone-39-search.webp" width="686" height="1400" loading="lazy"
           alt="Search for “hollow”: Hollow Knight in your games, a tracker item, news and releases — The Hollow Home, Hollow Stories: Lockdown — and IGDB results to add." />
      <img class="c-back" src="/assets/shots/iphone-39-wishlist.webp" width="686" height="1400" loading="lazy"
           alt="Library with Wishlist selected: Coming soon with covers and dates — Graveyard Keeper II, Control Resonant, The Legend of Zelda: Ocarina of Time — then No date yet." />
    </Reveal>
  </section>

  <section class="wrap story" id="calendar">
    <Reveal class="story__text">
      <h2>A year of play, in one screen</h2>
      <p class="lede">The calendar opens on a <strong>year</strong> — twelve small months and a heat map — because thirty years of history one month at a time is three hundred screens of scrolling.</p>
      <p class="lede">Scrub the years along the top. Ones holding something stand out; empty ones are still tappable, because the year you have nothing in is exactly the year you are about to write your first console into. Tap a month and it opens properly: full box art on every day you played, and what the month added up to underneath.</p>
      <p class="lede">The charts are here too, as the third view. Hours by game, what you finished, which systems you actually reach for — only what your own sessions can prove.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="right">
      <img class="c-front" src="/assets/shots/iphone-39-journal-calendar.webp" width="686" height="1400" loading="lazy"
           alt="The Journal calendar showing a whole year as twelve small months, each day a square shaded by how much was played, with a row of years along the top and 2026 selected." />
      <img class="c-back" src="/assets/shots/iphone-39-journal-pies.webp" width="686" height="1400" loading="lazy"
           alt="The Journal\u2019s charts as rings: 26 games by status \u2014 5 playing, 3 paused, 12 on the wishlist, 3 completed \u2014 and the same 26 by system, Switch first. " />
    </Reveal>
  </section>

  <section class="wrap story story--flip" id="light">
    <Reveal class="story__text">
      <h2>Light, dark, and your color</h2>
      <p class="lede">The whole app can be light now. Not the dark theme with its colors swapped — every surface knows which way <em>up</em> is, so a card lifts off a dark ground by getting lighter and off a light one by getting darker.</p>
      <p class="lede">And the background is yours. Accent and background sit on one screen, so you see a button against the ground you are choosing while you choose it. The app keeps its own contrast, so no choice can make text vanish.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="left">
      <img class="c-front" src="/assets/shots/iphone-39-light-home.webp" width="686" height="1400" loading="lazy"
           alt="LevelSelect home in light mode: a pale lilac ground, the profile and the week\u2019s totals across the top, Hollow Knight in Continue Playing and the systems below. " />
      <img class="c-back" src="/assets/shots/iphone-39-light-game-page.webp" width="686" height="1400" loading="lazy"
           alt="Clair Obscur: Expedition 33 in light mode: its key art faded behind the cover, Now Playing on PS5 with five stars, 24 hours 54 minutes over 10 sessions, and a Start Session button. " />
    </Reveal>
  </section>

  <section class="wrap story" id="retro">
    <Reveal class="story__text">
      <h2>Games older than the app you're tracking them in</h2>
      <p class="lede">Import the real <b>RetroAchievements</b> set for a retro game — the actual achievements the community authored, their real point values, and a warning on the ones you can permanently miss. Not a checklist someone guessed at.</p>
      <p class="lede">A game you finished in 2004 can say so. Beaten records take a year on its own, or a month, or a full date, so a finish you only half-remember doesn't have to be invented to be recorded.</p>
      <p class="lede">And a cartridge you still own, played on a handheld that isn't the original hardware, is <b>Physical and Emulated at once</b> — the shelf below sorts by the console it came out on, with emulators ranked last.</p>
    </Reveal>
    <Reveal class="composite composite--pair" from="right">
      <img class="c-front" src="/assets/shots/iphone-39-super-metroid-header.webp" width="686" height="1400" loading="lazy"
           alt="Super Metroid in LevelSelect: its own logo over key art, marked Completed on SNES, five stars, owned Emulated, a RetroAchievements badge, and a Beaten entry reading \u201cBeat the game \u00b7 SNES \u00b7 2022\u201d." />
      <img class="c-back" src="/assets/shots/iphone-39-sonic-header.webp" width="686" height="1400" loading="lazy"
           alt="Sonic the Hedgehog 2 on Genesis, its logo across the header art, marked Old Favorite and owned Physical and Emulated at once, beaten twice across 4 hours 42 minutes." />
    </Reveal>
  </section>

  <section class="wrap" id="stage">
    <Reveal>
      <h2>Play, check, and follow a guide at once</h2>
      <p class="lede">On iPad and Mac the game page slides aside to make room: the tracker, a guide playing, and the map, all at once.</p>
    </Reveal>
    <Reveal class="stage-shot">
      <img src="/assets/shots/ipad-39-stage.webp" width="1600" height="1227" loading="lazy"
           alt="Hollow Knight on iPad with three panes: its tracker under the game\u2019s logo on the left, a King\u2019s Pass guide video playing top right, and the Forgotten Crossroads map below it." />
    </Reveal>
    <Reveal>
      <p class="lede">This is the real layout — try it:</p>
    </Reveal>
    <Reveal>
      <StageDemo />
    </Reveal>
  </section>

  <section class="wrap" id="get">
    <Reveal class="card-hero beta-card">
      <h2>Try all of it</h2>
      <p class="lede">LevelSelect is in open testing on iPhone, iPad, Mac and Apple Watch. No form, no waiting.</p>
      <a class="btn btn-primary" href="https://testflight.apple.com/join/7pwdQEMq">Join the beta</a>
      <p class="beta-note"><a href="/docs/">How to use it</a> &middot; <a href="/changelog/">What's changed</a></p>
    </Reveal>
  </section>
</main>

<style is:global>
  .beta-card { display: block; text-align: center; }
  .beta-card h2 { margin-bottom: .4rem; }
  .beta-card .lede { margin: 0 auto 1.2rem; }
  .beta-note { margin: 1rem 0 0; font-size: .9rem; }
</style>
</Base>
