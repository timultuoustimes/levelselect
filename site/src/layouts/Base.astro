---
/**
 * The header and footer used to be copy-pasted into every page. Adding two
 * footer links meant editing four files — and one of them had drifted to a
 * different structure, so the edit silently missed it. That's the entire
 * reason this layout exists.
 */
import '../styles/style.css';

interface Props {
  title: string;
  description: string;
  /** Which nav link to mark as current. */
  current?: 'features' | 'changelog' | 'roadmap' | 'privacy' | 'about' | 'docs';
}
const { title, description, current } = Astro.props;

// Imported, not <link>ed to /assets/. The stylesheet lived in /assets/, which
// netlify.toml caches for a YEAR as `immutable` — correct for the fonts and
// images it was written for, badly wrong for a file that changes every time
// the design does. Importing it means Astro emits a content-hashed filename,
// so the immutable header becomes true rather than a trap.

const nav = [
  { href: '/#features', label: 'Features', key: 'features' },
  { href: '/docs/', label: 'Help', key: 'docs' },
  { href: '/changelog/', label: 'Changelog', key: 'changelog' },
  { href: '/roadmap/', label: 'Roadmap', key: 'roadmap' },
  { href: '/privacy/', label: 'Privacy', key: 'privacy' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" href="/assets/favicon.png" />
<link rel="alternate" type="application/rss+xml" title="LevelSelect changelog" href="/changelog/rss.xml" />
<meta name="theme-color" content="#0D0A17" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="LevelSelect" />
<meta property="og:url" content={new URL(Astro.url.pathname, "https://levelselect.app").href} />
{/* Without an og:image, unfurlers scavenge whatever image is on the page —
    Reddit picked a UI screenshot and cropped it into mush. This one is built
    to read at thumbnail size (scripts/make-social-images.py). Absolute URL:
    every unfurler requires one. */}
<meta property="og:image" content="https://levelselect.app/social/og-2up.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="LevelSelect — every game you're playing, and exactly where you left off. A library, session timer and progress tracker, shown on iPhone and iPad." />
{/* Bluesky and Mastodon read the og: tags above; these are the fallback the
    rest of the web still asks for. */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://levelselect.app/social/og-2up.png" />
</head>
<body>

<header class="bar">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/assets/icon.png" alt="" />
      <span class="pixel wordmark">LevelSelect</span>
    </a>
    <nav class="navlinks">
      {nav.map((item) => (
        <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    {/* Below the breakpoint the four links collided with the wordmark and ran
        off the edge. <details> gives a real disclosure menu with no JavaScript
        and correct keyboard/screen-reader behavior for free. */}
    <details class="navmenu">
      <summary aria-label="Menu">
        <span class="navmenu__bars" aria-hidden="true"></span>
      </summary>
      <div class="navmenu__panel">
        {nav.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href="/about/">How this was made</a>
      </div>
    </details>
  </div>
</header>

<style>
  /* One breakpoint, one rule each way — the inline links and the menu are
     never both present. */
  .navmenu { display: none; position: relative; }

  @media (max-width: 720px) {
    :global(.bar .navlinks) { display: none; }
    .navmenu { display: block; }
  }

  .navmenu > summary {
    list-style: none;
    cursor: pointer;
    padding: .45rem .3rem;
    border-radius: 8px;
    display: grid;
    place-items: center;
  }
  .navmenu > summary::-webkit-details-marker { display: none; }
  .navmenu > summary:focus-visible { outline: 2px solid var(--accent, #945CFA); outline-offset: 2px; }

  /* Three bars from one element: the middle is the box, the others are
     pseudo-elements. */
  .navmenu__bars,
  .navmenu__bars::before,
  .navmenu__bars::after {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink, #EDE8FA);
    transition: transform 220ms ease, opacity 160ms ease;
  }
  .navmenu__bars { position: relative; }
  .navmenu__bars::before,
  .navmenu__bars::after { content: ''; position: absolute; left: 0; }
  .navmenu__bars::before { top: -6px; }
  .navmenu__bars::after { top: 6px; }

  .navmenu[open] .navmenu__bars { background: transparent; }
  .navmenu[open] .navmenu__bars::before { transform: translateY(6px) rotate(45deg); }
  .navmenu[open] .navmenu__bars::after { transform: translateY(-6px) rotate(-45deg); }

  .navmenu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + .5rem);
    min-width: 12.5rem;
    display: flex;
    flex-direction: column;
    padding: .35rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #140F26;
    box-shadow: 0 14px 40px rgba(0, 0, 0, .55);
    z-index: 40;
  }
  .navmenu__panel a {
    padding: .6rem .7rem;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: .95rem;
  }
  .navmenu__panel a:hover,
  .navmenu__panel a[aria-current='page'] { color: var(--ink); background: rgba(255, 255, 255, .05); }

  @media (prefers-reduced-motion: reduce) {
    .navmenu__bars,
    .navmenu__bars::before,
    .navmenu__bars::after { transition: none; }
  }
</style>

<slot />

<footer>
  <div class="wrap">
    <span>&copy; 2026 LevelSelect</span>
    <span>
      <a href="/">Home</a> &middot;
      <a href="/docs/">Help</a> &middot;
      <a href="/roadmap/">Roadmap</a> &middot;
      <a href="/changelog/">Changelog</a> &middot;
      <a href="/privacy/">Privacy</a> &middot;
      <a href="/about/">How this was made</a> &middot;
      <a href="mailto:support@levelselect.app">support@levelselect.app</a> &middot;
      <a href="https://github.com/timultuoustimes/levelselect">GitHub</a>
    </span>
  </div>
</footer>

</body>
</html>
