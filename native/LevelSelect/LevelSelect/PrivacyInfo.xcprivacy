<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LevelSelect privacy manifest (beta P0).
	     Audit basis (2026-08-13): the only required-reason API used anywhere
	     in the app, widget, or watch targets is UserDefaults (@AppStorage UI
	     state, the Deku wishlist cache, and the random per-install id used
	     for edge-function rate limiting). No file-timestamp, disk-space,
	     system-boot-time, or keyboard APIs. No tracking, no ads, no
	     analytics SDKs. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The random per-install UUID sent with edge-function requests
		     (x-ls-install) exists solely for server-side rate limiting.
		     It is generated by the app, never tied to the user, their
		     iCloud account, or any hardware identifier. Declared as a
		     device identifier out of caution; App Store Connect answers
		     must match (App Functionality / not linked / no tracking). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info from same app, per Apple's list. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
