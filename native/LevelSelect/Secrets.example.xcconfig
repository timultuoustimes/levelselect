// Template for the gitignored `Secrets.xcconfig` that xcodegen reads.
// This repo is PUBLIC — the real file must never be committed.
//
// Create it before running `xcodegen generate`:
//
//   cd native/LevelSelect
//   printf 'LS_APP_KEY = %s\n' \
//     "$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48)" > Secrets.xcconfig
//
// The same value goes on the Supabase side, which is what turns the check on:
//
//   supabase secrets set LS_APP_SECRET=<the same value>
//
// Order matters. Set the Supabase secret only AFTER a build carrying the key
// is live — the edge functions skip the check while LS_APP_SECRET is unset, so
// older builds keep working until you flip it.
//
// The key ships inside the app binary, so it is a filter against drive-by
// abuse, not authentication. The server-side quotas are the real ceiling.

LS_APP_KEY =

// itch.io OAuth client id, from https://itch.io/user/settings/oauth-apps
//
// NOT a secret: the implicit flow has no client secret, and this value is
// visible in the authorisation URL every user sees. It lives here only
// because it varies by build and must not be hard-coded. Leave it empty and
// the itch.io section hides itself rather than offering a connection that
// cannot work.
//
// The OAuth app's redirect URI must be exactly:
//   https://levelselect.app/itch/callback

LS_ITCH_CLIENT_ID =
