node_modules/
dist/
.DS_Store

# --- native conversion: local-only working artifacts (repo is PUBLIC) ---
# Personal library exports (game names, notes, ratings, reviews) — never commit
native/fixtures/*.json
# Third-party app announcement screenshots (design reference only) — do not redistribute
native/design-references/
# Image-generation working files and source art — kept in ~/Dev/archive/levelselect-art/
public/generated/
public/generated-art/
public/retro-console-icons/

# --- native (Xcode / xcodegen) ---
# .xcodeproj is generated from project.yml by xcodegen — do not commit
native/LevelSelect/*.xcodeproj
native/LevelSelect/DerivedData/
native/**/.build/
*.xcuserstate
xcuserdata/

# generated by xcodegen from project.yml entitlements.properties
native/LevelSelect/LevelSelect/LevelSelect.entitlements

# personal library export bundled for one-time import (public repo)
# — Debug-only; Release drops it via EXCLUDED_SOURCE_FILE_NAMES in project.yml
native/LevelSelect/LevelSelect/Resources/legacy-import.json
# build-time app key for the edge functions — see Secrets.example.xcconfig
native/LevelSelect/Secrets.xcconfig
# generated by xcodegen from project.yml info.properties
native/LevelSelect/LevelSelect/Info.plist
native/LevelSelect/Widgets/LevelSelectWidgets.entitlements
native/LevelSelect/Watch/LevelSelectWatch.entitlements

# Deno lockfile, produced by `deno check` when verifying edge functions locally.
deno.lock
